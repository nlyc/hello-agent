# AgentFlow 配置示例
# 复制为 .env 后按需填写；.env 已在 .gitignore 中，不会提交。
# 优先级：Shell 环境变量 > .env > 代码默认值。

# ---------------------------------------------------------------- 在线 LLM
# 任意 OpenAI 兼容网关（DeepSeek / 中转站 / vLLM 等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# ---------------------------------------------------------------- 联网搜索
# 配置任意一个即可，Tavily 优先，失败回落到 SerpAPI
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARCH_MAX_RESULTS=3
# 本地知识库未命中（如未收录该城市）时，是否自动联网搜索后作答
SEARCH_FALLBACK=true

# ---------------------------------------------------------------- 语义向量
# hashing：离线零依赖；fastembed：在线语义模型（首次运行会下载模型）
EMBED_BACKEND=hashing
FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5
# 模型缓存目录；留空时默认使用 <仓库根>/.cache/fastembed
FASTEMBED_CACHE_PATH=
# HuggingFace 下载镜像（默认已内置 https://hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com

# ---------------------------------------------------------------- 检索与回答
# 向量召回的余弦相似度下限：0=关闭。
# FastEmbed 建议 0.30~0.35；Hashing 建议 0.08~0.10（两者分数量纲不同）
RAG_MIN_SCORE=0
# 问题点名城市但知识库没有该城市资料时，直接回答“未收录”，
# 不再用其它城市的相近片段作答
RAG_PLACE_GUARD=true
# 追加自定义地名（逗号/顿号分隔），用于地名覆盖校验，例如：景德镇,婺源
RAG_EXTRA_PLACES=

# ---------------------------------------------------------------- 向量库
# sqlite：本地文件；qdrant：远程服务
VECTOR_STORE=sqlite
RAG_SQLITE_PATH=.data/rag.sqlite3
# 远程 Qdrant（VECTOR_STORE=qdrant 时必填 URL）
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agentflow
QDRANT_TIMEOUT=30
QDRANT_PREFER_GRPC=false

# ---------------------------------------------------------------- 记忆
MEMORY_ENABLED=true
MEMORY_SQLITE_PATH=.data/memory.sqlite3
MEMORY_WORKING_MAX_ITEMS=50
MEMORY_WORKING_TTL_MINUTES=60
MEMORY_TOP_K=5
USER_ID=default

# ---------------------------------------------------------------- Agent
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_ITERATIONS=3
MAX_HISTORY_LENGTH=100
DEBUG=false

# 可选：指定 .env 文件位置（默认查找仓库根目录 .env）
# AGENTFLOW_ENV_FILE=D:/path/to/.env
